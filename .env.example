# ==========================================
# Puestos - Sistema de Gestión de Empleos
# ==========================================

# Base de datos PostgreSQL
POSTGRES_DB=puestos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contraseña_segura

# URL de conexión a la base de datos (generada automáticamente si no se especifica)
# DATABASE_URL=postgresql+psycopg://postgres:contraseña@db:5432/puestos

# Configuración de seguridad
SECRET_KEY=cambia_esta_clave_secreta_muy_larga_y_segura_para_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Configuración del usuario administrador por defecto
ADMIN_EMAIL=admin@puestos.com
ADMIN_PASSWORD=cambia_esta_contraseña_admin
ADMIN_NAME=Administrador

# ==========================================
# Configuración para Producción
# ==========================================

# Puerto del backend (opcional, por defecto 8000)
# BACKEND_PORT=8000

# Puerto del frontend (opcional, por defecto 80)
# FRONTEND_PORT=80

# Variables adicionales para configuración avanzada
# LOG_LEVEL=info
# WORKERS=4
